# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile (AUTH-P1D2) — CAPTCHA para OTP/login. INACTIVO por defecto.
# Site Key PÚBLICA (placeholder; la real la configura el owner). La Secret Key
# NUNCA va aquí ni al repo (se valida server-side en Supabase).
VITE_TURNSTILE_SITE_KEY=
# Bandera de despliegue: 'true' activa el CAPTCHA (requiere Site Key). Vacío/otro = inactivo.
VITE_CAPTCHA_ENABLED=
