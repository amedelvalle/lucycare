# ─── LucyCare — .env.local (NO commitear) ─────────────────────
#
# Copiá este archivo a `.env.local` en la raíz del repo y completá
# los valores reales. `.env.local` está en `.gitignore`.
#
# Usado únicamente por los scripts admin en /scripts/. El frontend
# tiene sus propias VITE_* vars en .env (también gitignored para
# el real, .env.example para el plantilla pública).

# URL del proyecto Supabase (mismo valor que VITE_SUPABASE_URL).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# anon key (la podés copiar de Supabase Dashboard → Settings → API).
# No es secreto crítico, pero la centralizamos acá para no tenerla
# hardcoded en scripts.
SUPABASE_ANON_KEY=eyJhbGciOiJI...your-anon-key...

# service_role key (Settings → API → service_role secret).
# ⚠ ESTO SÍ ES SECRETO CRÍTICO. Bypassea RLS y tiene acceso total.
# NUNCA lo commitees ni lo pongas en frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...your-service-role-key...
